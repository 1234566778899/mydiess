---
/**
 * Marco de iPhone (bisel negro redondeado) para las capturas reales de la
 * app. Las capturas ya traen su Dynamic Island.
 */
interface Props {
  src: string;
  alt: string;
  width?: number;
  class?: string;
  eager?: boolean;
}
const { src, alt, width = 300, class: className = '', eager = false } = Astro.props;
---

<figure class:list={['phone', className]} style={`--phone-width:${width}px`}>
  <img
    src={src}
    alt={alt}
    width="750"
    height="1631"
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
  />
</figure>

<style>
  .phone {
    margin: 0;
    width: min(var(--phone-width), 100%);
    aspect-ratio: 1206 / 2622;
    padding: calc(var(--phone-width) * 0.035);
    background: linear-gradient(145deg, #2c2c2e, #0b0b0c 55%, #2c2c2e);
    border-radius: calc(var(--phone-width) * 0.17);
    box-shadow:
      inset 0 0 0 1.5px rgba(255, 255, 255, 0.12),
      0 30px 60px -20px rgba(0, 0, 0, 0.35),
      0 18px 36px -18px rgba(0, 0, 0, 0.3);
    max-width: 100%;
  }
  .phone img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    border-radius: calc(var(--phone-width) * 0.135);
  }
</style>
