---
import { nav, site } from '../config/site';
---

<header class="globalnav" data-globalnav>
  <nav class="globalnav-inner" aria-label="Principal">
    <a class="globalnav-brand" href="/" aria-label={`${site.name}, inicio`}>
      <img src="/brand/app-icon-32.png" alt="" width="22" height="22" />
      <span>{site.name}</span>
    </a>

    <ul class="globalnav-links" id="globalnav-menu">
      {nav.map((item) => (
        <li><a href={item.href}>{item.label}</a></li>
      ))}
    </ul>

    <div class="globalnav-actions">
      <a class="globalnav-cta" href={site.appStoreUrl}>Descargar</a>
      <button class="globalnav-toggle" type="button" aria-expanded="false" aria-controls="globalnav-menu" aria-label="Abrir menú">
        <span></span><span></span>
      </button>
    </div>
  </nav>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-globalnav]');
  const toggle = header?.querySelector<HTMLButtonElement>('.globalnav-toggle');
  toggle?.addEventListener('click', () => {
    const open = header!.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
    document.body.style.overflow = open ? 'hidden' : '';
  });
  header?.querySelectorAll('.globalnav-links a').forEach((link) =>
    link.addEventListener('click', () => {
      header.classList.remove('is-open');
      toggle?.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    })
  );
</script>

<style>
  .globalnav {
    position: sticky;
    top: 0;
    z-index: 100;
    height: 48px;
    background: rgba(250, 250, 252, 0.8);
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
  }

  .globalnav-inner {
    height: 100%;
    width: min(1024px, 100% - 44px);
    margin-inline: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .globalnav-brand {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--ink);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: none;
    min-height: 44px;
  }
  .globalnav-brand img {
    border-radius: 6px;
  }

  .globalnav-links {
    display: flex;
    flex: 1;
    justify-content: center;
    gap: 36px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .globalnav-links a {
    color: rgba(0, 0, 0, 0.8);
    font-size: 12px;
    letter-spacing: -0.01em;
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .globalnav-links a:hover {
    color: var(--ink);
  }

  .globalnav-actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .globalnav-cta {
    background: var(--pink);
    color: #fff;
    font-size: 12px;
    padding: 4px 12px;
    border-radius: 980px;
    text-decoration: none;
  }
  .globalnav-cta:hover {
    background: var(--pink-deep);
    text-decoration: none;
  }

  .globalnav-toggle {
    display: none;
    width: 44px;
    height: 44px;
    border: 0;
    background: transparent;
    position: relative;
    cursor: pointer;
  }
  .globalnav-toggle span {
    position: absolute;
    left: 14px;
    width: 16px;
    height: 1.5px;
    background: var(--ink);
    border-radius: 2px;
    transition: transform 0.3s ease, top 0.3s ease;
  }
  .globalnav-toggle span:first-child {
    top: 18px;
  }
  .globalnav-toggle span:last-child {
    top: 25px;
  }

  @media (max-width: 834px) {
    .globalnav-toggle {
      display: block;
    }
    .globalnav-links {
      position: fixed;
      inset: 48px 0 0 0;
      flex-direction: column;
      justify-content: flex-start;
      gap: 0;
      padding: 16px 44px;
      background: rgba(250, 250, 252, 0.97);
      backdrop-filter: saturate(180%) blur(20px);
      -webkit-backdrop-filter: saturate(180%) blur(20px);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-8px);
      transition: opacity 0.25s ease, transform 0.25s ease, visibility 0.25s;
    }
    .globalnav-links a {
      display: block;
      font-family: var(--font-display);
      font-size: 28px;
      font-weight: 600;
      line-height: 1.8;
      color: var(--ink);
    }
    :global(.globalnav.is-open) .globalnav-links {
      opacity: 1;
      visibility: visible;
      transform: none;
    }
    :global(.globalnav.is-open) .globalnav-toggle span:first-child {
      top: 21px;
      transform: rotate(45deg);
    }
    :global(.globalnav.is-open) .globalnav-toggle span:last-child {
      top: 21px;
      transform: rotate(-45deg);
    }
  }
</style>
